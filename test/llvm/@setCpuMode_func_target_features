# "arm/thumb ISAs"

#write test.zig {
export fn a() void {
	@setCpuMode(.arm);
}

export fn b() void {
	@setCpuMode(.thumb);
}
#}

#zig build-obj {
--name test -ofmt=llvmir -fno-lld -fno-new-linker
-target thumb-freestanding
-Mroot=test.zig
#}

#update
#check llvm {
...
define ... void @test.b() ... #attrs_b ... {
  ...
}
...
define ... void @test.a() ... #attrs_a ... {
  ...
}
...
attributes #attrs_b = { ... "target-features"="...+,+thumb-mode" ... }
...
attributes #attrs_a = { ... "target-features"="...+,-thumb-mode" ... }

...
#}

